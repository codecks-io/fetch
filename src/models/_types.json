  "descriptions": {
    "card": "A task or a document card when `isDoc` is set or a hero card if it contains sub cards.\nThe card's color is derived from `status`, `visibility`, `isDoc` and whether it has sub cards or open block or review conversations.",
    "card.assignee": "The card's owner.",
    "card.attachments": "In the order the card shows them.",
    "card.cardReferences": "The cards that `content` links to.",
    "card.childCards": "A hero card's sub cards, in order.",
    "card.coverFile": "The image shown on the card's front.",
    "card.creator": "`null` for cards an import created.",
    "card.deck": "`null` for a private card, which only its creator sees.",
    "card.diffs": "The card's change history.",
    "card.handCards": "One entry per user who bookmarked the card.",
    "card.inDeps": "The cards that have to be done before this one.",
    "card.outDeps": "The cards that wait for this one. The counterpart of their `inDeps`.",
    "card.parentCard": "The hero card this card is a sub card of.",
    "card.queueEntries": "One entry per user who has the card in their Card Hand.",
    "card.resolvableEntries": "Every comment on the card, across its threads.",
    "card.resolvables": "The card's comment threads, including reviews and blockers (`context`).",
    "card.sourceWorkflowItem": "The journey step the card was created from.",
    "card.sprint": "The run the card is planned into.",
    "card.accountSeq": "The card's number within the organization. It's stored as a plan number starting at 1. The web app shows it encoded as a short code after a `$`, like `$12a`. Check [this gist](https://gist.github.com/danielberndt/19857421171dbb07a3681f0ea6634049) for how to translate the number into the shown string and vice versa.",
    "card.assigneeId": "The card's owner.",
    "card.checkboxInfo": "The checkboxes in `content`, in order.",
    "card.checkboxStats": "How many checkboxes `content` has, and how many of them are checked.",
    "card.content": "The card's text as markdown. Its first line is the `title`. Tags, mentions, checkboxes and card references in it fill `tags`, `masterTags`, `mentionedUsers`, `checkboxStats`, `checkboxInfo` and `cardReferences`.",
    "card.coverFileId": "The image shown on the card's front.",
    "card.creatorId": "`null` for cards an import created.",
    "card.deckId": "`null` for a private card, which only its creator sees.",
    "card.derivedStatus": "The state the web app shows, combining `status`, `visibility`, `isDoc`, open review and blocker threads, the assignee and whether it's a hero card: e.g. `blocked` for an open blocker thread, `unassigned` for a not started card without an assignee.",
    "card.effort": "On the organization's scale, `account.effortScale`.",
    "card.hasBlockingDeps": "One of `inDeps` isn't done yet.",
    "card.isBlockingDep": "The card isn't done yet, and one of its `outDeps` isn't either.",
    "card.isDoc": "`true` for a document card: it holds information instead of a task, so it's never started or done.",
    "card.lastUpdatedAt": "When the card last changed.",
    "card.masterTags": "The card's project tags: the tags from the project's tag list, whether written as `#tag` in `content` or set directly, plus the deck's auto-tag. Writing them may change `content`.",
    "card.mentionedUsers": "The users mentioned in `content`.",
    "card.parentCardId": "The hero card this card is a sub card of.",
    "card.priority": "`a`, `b` or `c`: High, Medium and Low, unless the organization renamed them (`account.priorityLabels`).",
    "card.sourceWorkflowItemId": "The journey step the card was created from.",
    "card.sprintId": "The run the card is planned into.",
    "card.status": "`snoozing` will only be set on `started` card that nobody changed for the organization's snooze time (`account.statusChangeDurations`); it can't be written. `derivedStatus` is the state the web app shows.",
    "card.tags": "Every tag on the card: the `#tags` in `content` and the `masterTags`, each once.",
    "card.title": "The first line of `content` as plain text, without markdown and cut to 80 characters. Write `content` to change it.",
    "card.version": "Goes up with every change to the card.",
    "card.visibility": "`archived` cards are put away, `deleted` ones are in the trash. Both stay readable.",
    "user": "A person, or an integration or API token that acts in an organization. `kind` tells them apart.",
    "user.fullName": "`null` unless the user entered one.",
    "user.isIntegration": "`true` for every `kind` other than `human`.",
    "user.kind": "`integration` is the user an integration like GitHub or Slack acts as, `api_token` the one an organization's API token acts as.",
    "user.name": "The username. `\"\"` when none is set. An API token's user carries the token's label.",
    "user.timezone": "An IANA time zone like `Europe/Berlin`. Only readable on your own user: `null` on everyone else's."
  }
}
