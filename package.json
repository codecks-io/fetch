{
  "name": "@codecks/fetch",
  "version": "0.0.1",
  "description": "Quickly create deeply nested queries for the Codecks API with advanced TypeScript support",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/codecks-io/cdx-fetch#readme",
  "bugs": {
    "url": "https://github.com/codecks-io/cdx-fetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecks-io/cdx-fetch.git"
  },
  "author": "Daniel Berndt <daniel@codecks.io>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typescheck && npm run build && npm run check-format && npm run test",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.15.17",
    "msw": "^2.10.4",
    "prettier": "^3.6.2",
    "tsdown": "^0.11.9",
    "typescript": "^5.9.2",
    "vite-node": "^3.2.4",
    "vitest": "^3.1.3"
  }
}
